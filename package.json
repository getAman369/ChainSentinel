{
  "name": "chainsentinel",
  "version": "1.0.0",
  "description": "ChainSentinel — AML/Fraud Detection API with on-chain attestation on Base L2",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network baseSepolia",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "web:lint": "npm --prefix web run lint",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "keywords": ["blockchain", "aml", "fraud-detection", "ethereum", "base", "ai", "ml"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "rate-limiter-flexible": "^5.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "hardhat": "^2.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}